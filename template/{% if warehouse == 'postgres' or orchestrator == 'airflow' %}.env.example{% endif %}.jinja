# Copy to `.env` for local development.
# `.env` is git-ignored, so real secrets never belong here or in git.
{% if warehouse == 'postgres' -%}
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5436
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
{% endif -%}
{% if orchestrator == 'airflow' -%}
# Airflow local stack. Change these for anything beyond local development.
# The JWT secret and metadata database password must be real secrets in production.
# AIRFLOW_UID=1000
# Defaults to your host user id (`id -u`) so containers can write ./data.
AIRFLOW_PORT=8080
AIRFLOW_JWT_SECRET=dev-only-change-me-to-a-long-random-secret
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
{% endif -%}
