"""Configuration for the weather pipeline."""

from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path

FORECAST_URL = "https://api.open-meteo.com/v1/forecast"
ARCHIVE_URL = "https://archive-api.open-meteo.com/v1/archive"

HOURLY_VARS = [
    "temperature_2m",
    "relative_humidity_2m",
    "precipitation",
    "wind_speed_10m",
]

DATA_DIR = Path(os.environ.get("PIPELINE_DATA_DIR", "./data"))
OFFLINE = os.environ.get("PIPELINE_OFFLINE") == "1"

{% if warehouse == 'duckdb' -%}
DUCKDB_PATH = Path(os.environ.get("DUCKDB_PATH", str(DATA_DIR / "warehouse.duckdb")))
{% else -%}
WAREHOUSE_HOST = os.environ.get("WAREHOUSE_HOST", "localhost")
WAREHOUSE_PORT = int(os.environ.get("WAREHOUSE_PORT", "5436"))
WAREHOUSE_DB = os.environ.get("WAREHOUSE_DB", "warehouse")
WAREHOUSE_USER = os.environ.get("WAREHOUSE_USER", "warehouse")
WAREHOUSE_PASSWORD = os.environ.get("WAREHOUSE_PASSWORD", "warehouse")
{% endif %}

@dataclass(frozen=True)
class City:
    """A city to collect weather for."""

    name: str
    latitude: float
    longitude: float


CITIES = [
{% for city in cities -%}
    City(
        name={{ city.name | tojson }},
        latitude={{ city.latitude }},
        longitude={{ city.longitude }},
    ),
{% endfor -%}
]
