# Generated by data-pipeline-template.

COMPOSE ?= $(shell docker compose version >/dev/null 2>&1 && echo "docker compose" || echo docker-compose)
PYTHON ?= .venv/bin/python
DBT ?= $(PYTHON) -m dbt.cli.main
DBT_FLAGS ?= --project-dir dbt --profiles-dir dbt

.PHONY: install extract load run backfill build test lint ci up down clean

install:
	$(PYTHON) -m pip install --upgrade pip
	$(PYTHON) -m pip install -e '.[dev]'

extract:
	$(PYTHON) -m {{ package_name }} extract

load:
	$(PYTHON) -m {{ package_name }} load

run:
	$(PYTHON) -m {{ package_name }} run

backfill:
	$(PYTHON) -m {{ package_name }} backfill --start $(START) --end $(END)

build:
	$(DBT) seed $(DBT_FLAGS)
	$(DBT) build $(DBT_FLAGS)
	$(DBT) source freshness $(DBT_FLAGS)

test:
	PIPELINE_OFFLINE=1 $(PYTHON) -m pytest -q

lint:
	@echo "ruff and sqlfluff are wired in step 7."

ci: lint test
	PIPELINE_OFFLINE=1 $(PYTHON) -m {{ package_name }} run
	$(MAKE) build

{% if orchestrator == 'airflow' %}
up:
	@echo "Airflow local stack is wired in step 9; use 'make run build' for now."
{% elif warehouse == 'postgres' %}
up:
	$(COMPOSE) up -d
	@echo "Waiting for warehouse-db to become healthy..."
	@until $(COMPOSE) exec -T warehouse-db pg_isready -U $${WAREHOUSE_USER:-warehouse} -d $${WAREHOUSE_DB:-warehouse} >/dev/null 2>&1; do sleep 1; done
	$(MAKE) run build
{% else %}
up: run build
{% endif %}

{% if warehouse == 'postgres' or orchestrator == 'airflow' %}
down:
	$(COMPOSE) down
{% else %}
down:
	@echo "Nothing to stop for DuckDB; run 'make clean' to remove local data."
{% endif %}

clean:
	rm -rf data dbt/target dbt/logs .pytest_cache
