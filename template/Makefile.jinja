# Generated by data-pipeline-template.

COMPOSE ?= $(shell docker compose version >/dev/null 2>&1 && echo "docker compose" || echo docker-compose)
PYTHON ?= .venv/bin/python
DBT ?= $(PYTHON) -m dbt.cli.main
DBT_FLAGS ?= --project-dir dbt --profiles-dir dbt
{% if warehouse == 'postgres' or orchestrator == 'airflow' %}
-include .env
{% endif %}
{% if warehouse == 'postgres' %}
WAREHOUSE_HOST ?= localhost
WAREHOUSE_PORT ?= 5436
WAREHOUSE_DB ?= warehouse
WAREHOUSE_USER ?= warehouse
WAREHOUSE_PASSWORD ?= warehouse
export WAREHOUSE_HOST WAREHOUSE_PORT WAREHOUSE_DB WAREHOUSE_USER WAREHOUSE_PASSWORD
{% endif %}
{% if orchestrator == 'airflow' %}
AIRFLOW_PORT ?= 8080
AIRFLOW_USERNAME ?= $(_AIRFLOW_WWW_USER_USERNAME)
AIRFLOW_PASSWORD ?= $(_AIRFLOW_WWW_USER_PASSWORD)
AIRFLOW_USERNAME := $(or $(AIRFLOW_USERNAME),airflow)
AIRFLOW_PASSWORD := $(or $(AIRFLOW_PASSWORD),airflow)
export AIRFLOW_PORT AIRFLOW_USERNAME AIRFLOW_PASSWORD
{% endif %}

.PHONY: install extract load run backfill build test lint ci up down clean

install:
	test -x $(PYTHON) || python{{ python_version }} -m venv .venv
	$(PYTHON) -m pip install --upgrade pip
	$(PYTHON) -m pip install -e '.[dev]'

extract:
	$(PYTHON) -m {{ package_name }} extract

load:
	$(PYTHON) -m {{ package_name }} load

run:
	$(PYTHON) -m {{ package_name }} run

backfill:
	$(PYTHON) -m {{ package_name }} backfill --start $(START) --end $(END)

build:
	$(DBT) seed $(DBT_FLAGS)
	$(DBT) build $(DBT_FLAGS)
	$(DBT) source freshness $(DBT_FLAGS)

test:
	PIPELINE_OFFLINE=1 $(PYTHON) -m pytest -q

lint:
	$(PYTHON) -m ruff check .
	$(PYTHON) -m ruff format --check .
	$(PYTHON) -m sqlfluff lint dbt/models

ci: lint test
	PIPELINE_OFFLINE=1 $(PYTHON) -m {{ package_name }} run
	$(MAKE) build

{% if orchestrator == 'airflow' %}
up:
	$(COMPOSE) build
	$(COMPOSE) up -d
	@echo "Waiting for the Airflow apiserver to become healthy..."
	@until $(COMPOSE) exec -T airflow-apiserver curl --fail --silent http://localhost:8080/api/v2/monitor/health >/dev/null 2>&1; do sleep 2; done
	$(COMPOSE) exec -T airflow-scheduler airflow dags unpause weather_pipeline
	$(COMPOSE) exec -T airflow-scheduler airflow dags trigger weather_pipeline
	@echo "Airflow UI: http://localhost:$(AIRFLOW_PORT) (login: $(AIRFLOW_USERNAME) / $(AIRFLOW_PASSWORD))"
{% elif warehouse == 'postgres' %}
up:
	$(COMPOSE) up -d
	@echo "Waiting for warehouse-db to become healthy..."
	@until $(COMPOSE) exec -T warehouse-db pg_isready -U $(WAREHOUSE_USER) -d $(WAREHOUSE_DB) >/dev/null 2>&1; do sleep 1; done
	$(MAKE) run build
{% else %}
up: run build
{% endif %}

{% if warehouse == 'postgres' or orchestrator == 'airflow' %}
down:
	$(COMPOSE) down --remove-orphans $(if $(filter 1,$(VOLUMES)),--volumes,)
{% else %}
down:
	@echo "Nothing to stop for DuckDB; run 'make clean' to remove local data."
{% endif %}

clean:
	rm -rf data dbt/target dbt/logs .pytest_cache
